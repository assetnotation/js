{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetnotation.org/schema/0.1.0/asset-notation.schema.json",
  "title": "Asset Notation Document",
  "description": "Schema for an Asset Notation v0.1.0 document. See versions/0.1.0.md for the normative specification.",
  "type": "object",
  "required": ["assetnotation", "generatedAt", "holdings"],
  "properties": {
    "assetnotation": {
      "description": "Spec version major.minor.patch. Compatibility is keyed on major.minor.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "generatedAt": {
      "description": "When the document was produced (RFC 3339 timestamp).",
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "baseCurrency": { "$ref": "#/$defs/currencyCode" },
    "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
    "institutions": { "type": "array", "items": { "$ref": "#/$defs/institution" } },
    "holdings": { "type": "array", "items": { "$ref": "#/$defs/holding" } },
    "instruments": { "type": "array", "items": { "$ref": "#/$defs/instrument" } },
    "valuations": { "type": "array", "items": { "$ref": "#/$defs/valuation" } },
    "transactions": { "type": "array", "items": { "$ref": "#/$defs/transaction" } },
    "ownership": { "type": "array", "items": { "$ref": "#/$defs/ownership" } },
    "extensions": {
      "description": "Namespaced app-specific data, keyed by reverse-DNS or app id.",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "currencyCode": {
      "description": "ISO 4217 alphabetic code.",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "countryCode": {
      "description": "ISO 3166-1 alpha-2 code.",
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "date": {
      "description": "ISO 8601 calendar date YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateOrTimestamp": {
      "description": "An ISO 8601 date or an RFC 3339 timestamp.",
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        { "format": "date-time" }
      ]
    },
    "decimalString": {
      "description": "Base-10 decimal string. Never a float.",
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "ref": {
      "description": "A reference to another entity's id.",
      "type": "string",
      "minLength": 1
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "$ref": "#/$defs/decimalString" },
        "currency": { "$ref": "#/$defs/currencyCode" }
      },
      "additionalProperties": false
    },
    "link": {
      "description": "A relation from one holding to another.",
      "type": "object",
      "required": ["rel", "holdingId"],
      "properties": {
        "rel": { "type": "string", "minLength": 1 },
        "holdingId": { "$ref": "#/$defs/ref" }
      },
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["person", "entity"] },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "country": { "$ref": "#/$defs/countryCode" },
        "ids": { "type": "object" }
      },
      "additionalProperties": true
    },
    "institution": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["bank", "broker", "insurer", "exchange", "custodian", "other"]
        },
        "country": { "$ref": "#/$defs/countryCode" },
        "ids": { "type": "object" }
      },
      "additionalProperties": true
    },
    "holding": {
      "type": "object",
      "required": ["id", "kind", "nature"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "Open vocabulary. Consumers MUST accept an unknown kind.",
          "type": "string",
          "minLength": 1
        },
        "nature": { "type": "string", "enum": ["asset", "liability"] },
        "label": { "type": "string" },
        "currency": { "$ref": "#/$defs/currencyCode" },
        "parentId": { "$ref": "#/$defs/ref" },
        "institutionId": { "$ref": "#/$defs/ref" },
        "ids": { "type": "object" },
        "instrumentId": { "$ref": "#/$defs/ref" },
        "quantity": { "$ref": "#/$defs/decimalString" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "attributes": { "type": "object" },
        "openedAt": { "$ref": "#/$defs/date" },
        "closedAt": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": true
    },
    "instrument": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["security", "cash", "crypto", "commodity", "other"]
        },
        "ids": { "type": "object" },
        "currency": { "$ref": "#/$defs/currencyCode" }
      },
      "additionalProperties": true
    },
    "valuation": {
      "type": "object",
      "required": ["id", "holdingId", "asOf", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "holdingId": { "$ref": "#/$defs/ref" },
        "asOf": { "$ref": "#/$defs/dateOrTimestamp" },
        "value": { "$ref": "#/$defs/money" },
        "unitPrice": { "$ref": "#/$defs/money" },
        "source": {
          "description": "Open vocabulary. Consumers MUST accept an unknown source.",
          "type": "string"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "transaction": {
      "type": "object",
      "required": ["id", "holdingId", "date", "amount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "holdingId": { "$ref": "#/$defs/ref" },
        "date": { "$ref": "#/$defs/date" },
        "amount": { "$ref": "#/$defs/money" },
        "type": {
          "type": "string",
          "enum": ["transfer", "trade", "fee", "dividend", "interest", "income", "expense", "other"]
        },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "counterpartHoldingId": { "$ref": "#/$defs/ref" },
        "instrumentId": { "$ref": "#/$defs/ref" },
        "quantity": { "$ref": "#/$defs/decimalString" }
      },
      "additionalProperties": true
    },
    "ownership": {
      "type": "object",
      "required": ["subjectId", "holdingId", "share"],
      "properties": {
        "subjectId": { "$ref": "#/$defs/ref" },
        "holdingId": { "$ref": "#/$defs/ref" },
        "share": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  }
}
